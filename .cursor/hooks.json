{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/record_provenance.py"
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 .cursor/hooks/record_provenance.py"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/record_provenance.py"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 .cursor/hooks/record_provenance.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/record_provenance.py"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "python3 .cursor/hooks/record_provenance.py"
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/record_provenance.py"
      }
    ]
  }
}